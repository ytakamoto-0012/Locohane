# web-searchスキル専用のTavily APIキー設定。
# このファイルを .env にコピーし、実際のキーを設定する。
# https://app.tavily.com で無料枠のAPIキーを取得できる。
# .env は .gitignore 済み（ルートの.gitignoreの ".env" パターンがサブディレクトリにも
# マッチするため追加設定不要）。
TAVILY_API_KEY=

# --- 危険サイト対策（ドメインフィルタ） ---
# 検索結果から既定で除外するドメインのリスト。サブドメインも自動的に対象になる
# （例: "example.com" を指定すると "sub.example.com" も除外される）。
# config.ini の project_locohane_dir 等と同じJSON/Python風リスト形式（角カッコ＋
# 改行複数行OK）で指定する。空リスト [] なら除外なし。組織のポリシーに応じて
# アダルト/出会い系/違法賭博/既知フィッシング等のドメインを追記して運用する
# （例: WEB_SEARCH_BLOCKED_DOMAINS = ["example-adult.com", "example-gambling.com"]）。
# 以下は実際にウイルスバスターの検知に引っかかった既知の危険ドメイン
# （運用中に見つかったものをここへ追記していく）。
WEB_SEARCH_BLOCKED_DOMAINS = [
    "lushdawnvalley.info",
    ]

# 指定した場合、検索結果をこのドメイン群のみに限定する（ホワイトリストモード）。
# WEB_SEARCH_BLOCKED_DOMAINSと両方指定した場合はAND条件で適用される（許可リストに
# 含まれていても、除外リストにも一致すれば結果から除外される。片方が優先されるの
# ではない）。
# 上記と同じJSON/Python風リスト形式で指定する。空リスト [] なら制限なし。
#
# 【重要】このファイル(.env.example)は、下記の値が既定で有効(コメントアウトなし)の
# まま同梱されています。手順通りに.envへコピーしただけでも、Web検索結果は最初から
# 下記ドメインのみに限定されます。幅広く検索させたい場合は [] にするか、プロジェクトの
# 用途に合わせて書き換えてください。
#
# 参考: ClaudeCode/Codex/Cowork等の主要コーディングエージェントは「既知の危険
# ドメインを列挙してブロックする」denylist方式ではなく、「原則ブロックし、必要な
# ドメインだけ許可する」allowlist方式を採る（Codexは既定でエージェントの
# インターネットアクセス自体をブロックしており、有効化する場合もdenylistではなく
# allowlistプリセットを提示する）。用途を絞れる場合はこちらのallowlist方式を使う
# ことを推奨する。一例として、Codexの「Common dependencies」プリセット
# （パッケージ管理・ソース管理向けの許可リスト）に含まれる代表的なドメインを
# 挙げる（そのまま有効化はされない。必要に応じてコメントを外して使う）:
# WEB_SEARCH_ALLOWED_DOMAINS = [
#     "github.com",
#     "gitlab.com",
#     "bitbucket.org",
#     "pypi.org",
#     "npmjs.com",
#     "rubygems.org",
#     "crates.io",
#     "maven.org",
#     "golang.org",
#     "docker.com",
#     ]
WEB_SEARCH_ALLOWED_DOMAINS = [
    "github.com",
    "gitlab.com",
    "bitbucket.org",
    "pypi.org",
    "npmjs.com",
    "rubygems.org",
    "crates.io",
    "maven.org",
    "golang.org",
    "docker.com",
    ]

# Tavily APIへの接続タイムアウト秒数（省略時は30）。
WEB_SEARCH_TIMEOUT_SECONDS=30
