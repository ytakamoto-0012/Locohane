\x8c\xe3\x81\xa0\xe3\x81\x91\xe3\x81\x9a\xe3\x82\x8c\xe3\x81\xa6\xe3\x81\x84\xe3\x82\x8b\xe3\x81\x8b)\n        *   \xe3\x83\x87\xe3\x83\xbc\xe3\x82\xbf\xe3\x81\x8c\xe3\x81\xaa\xe3\x81\x84\xe5\xa0\xb4\xe5\x90\x88\xe3\x82\x84\xe5\xb9\x85\xe3\x81\x8c0\xe3\x81\xae\xe5\xa0\xb4\xe5\x90\x88\xe3\x81\xaf `pg = 0` \xe3\x81\xbe\xe3\x81\x9f\xe3\x81\xaf `Y05` \xe3\x82\x92\xe8\xa8\xad\xe5\xae\x9a\xe3\x80\x82\n\n2.  **\xe9\x9a\xa3\xe6\x8e\xa5\xe5\x80\xa4\xe8\xa8\x88\xe7\xae\x97 (Rinsetu)**\n    *   \xe8\xa8\x88\xe7\xae\x97\xe3\x81\x95\xe3\x82\x8c\xe3\x81\x9f3\xe7\x82\xb9\xe3\x82\xb2\xe3\x83\xbc\xe3\x82\xb8\xe5\x80\xa4\xef\xbc\x88`tCells_b` \xe3\x81\xbe\xe3\x81\x9f\xe3\x81\xaf `tCells_k`\xef\xbc\x89\xe3\x82\x92\xe4\xbd\xbf\xe3\x81\xa3\xe3\x81\xa6\xe8\xa8\x88\xe7\xae\x97\xe3\x81\x97\xe3\x81\xbe\xe3\x81\x99\xe3\x80\x82\n    *   \xe5\xaf\xbe\xe8\xb1\xa1\xe7\x82\xb9\xe3\x81\xae3\xe7\x82\xb9\xe3\x82\xb2\xe3\x83\xbc\xe3\x82\xb8\xe5\x80\xa4\xe3\x81\x8b\xe3\x82\x89\xe3\x80\x81\xe5\xb7\xa6\xe5\x81\xb4\xe3\x81\xae\xe9\x9a\xa3\xe6\x8e\xa5\xe7\x82\xb9\xe3\x81\xae3\xe7\x82\xb9\xe3\x82\xb2\xe3\x83\xbc\xe3\x82\xb8\xe5\x80\xa4\xe3\x82\x92\xe5\xbc\x95\xe3\x81\x8d\xe3\x81\xbe\xe3\x81\x99\xe3\x80\x82\n    *   `r_Cur = tCells(H + 1, W + 1) - tCells(H + 1, W + 1 - W2)`\n    *   \xe3\x81\x93\xe3\x81\xae\xe5\xb7\xae\xe3\x81\xae\xe7\xb5\xb6\xe5\xaf\xbe\xe5\x80\xa4 `abs_Cur` \xe3\x81\x8c\xe6\x9c\x80\xe5\xa4\xa7\xe3\x81\xab\xe3\x81\xaa\xe3\x82\x8b\xe3\x82\x82\xe3\x81\xae\xe3\x82\x92\xe6\x8e\xa2\xe3\x81\x97\xe3\x81\xbe\xe3\x81\x99\xe3\x80\x82\n    *   \xe6\x8e\xa2\xe7\xb4\xa2\xe7\xaf\x84\xe5\x9b\xb2\xe3\x81\xaf `W2 = 1` \xe3\x81\x8b\xe3\x82\x89 `xWidth`\xef\xbc\x883\xe7\x82\xb9\xe3\x82\xb2\xe3\x83\xbc\xe3\x82\xb8\xe8\xa8\x88\xe7\xae\x97\xe3\x81\xa7\xe6\xb1\x82\xe3\x82\x81\xe3\x81\x9f\xe3\x83\x94\xe3\x83\x83\xe3\x83\x81\xe5\xb9\x85\xef\xbc\x89\xe3\x81\xbe\xe3\x81\xa7\xe3\x80\x82\n    *   \xe6\x9c\x80\xe5\xa4\xa7\xe5\x80\xa4 `r_Max` \xe3\x82\x92\xe6\x9c\x80\xe7\xb5\x82\xe7\x9a\x84\xe3\x81\xaa\xe9\x9a\xa3\xe6\x