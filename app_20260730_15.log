(0)(1) + bounds(1)(1)) / 2\n        centerZ = (bounds(0)(2) + bounds(1)(2)) / 2\n    Catch ex As Exception\n        centerX = 0\n        centerY = 0\n        centerZ = 0\n    End Try\nEnd Sub\n\n\'// ============================================================\n// \xe3\x82\xb5\xe3\x83\x96\xe3\x83\x97\xe3\x83\xad\xe3\x82\xb7\xe3\x83\xbc\xe3\x82\xb8\xe3\x83\xa3: \xe6\xb3\x95\xe7\xb7\x9a\xe3\x83\x99\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xab\xe3\x81\xae\xe4\xb8\x80\xe8\x87\xb4\xe3\x83\x81\xe3\x82\xa7\xe3\x83\x83\xe3\x82\xaf\n\'// ============================================================\nFunction _IsNormalMatch(nx As Double, ny As Double, nz As Double,\n                       targetX As Double, targetY As Double, targetZ As Double) As Boolean\n    Dim dotProduct As Double\n    Dim magnitude1 As Double, magnitude2 As Double\n    \n    \'// \xe5\x86\x85\xe7\xa9\x8d\xe3\x82\x92\xe8\xa8\x88\xe7\xae\x97\n    dotProduct = nx * targetX + ny * targetY + nz * targetZ\n    \n    \'// \xe5\x90\x84\xe3\x83\x99\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xab\xe3\x81\xae\xe5\xa4\xa7\xe3\x81\x8d\xe3\x81\x95\xe3\x82\x92\xe8\xa8\x88\xe7\xae\x97\n    magnitude1 = Sqr(nx * nx + ny * ny + nz * nz)\n    magnitude2 = Sqr(targetX * targetX + targetY * targetY + targetZ * targetZ)\n    \n    \'// \xe6\xad\xa3\xe8\xa6\x8f\xe5\x8c\x96\n    If magnitude1 > 0 And magnitude2 > 0 Then\n        dotProduct = dotProduct / (magnitude1 * magnitude2)\n    End If\n    \n    \'// \xe4\xb8\x80\xe8\x87\xb4\xe5\x88\xa4\xe5\xae\x9a\xef\xbc\x88cos\xe5\x80\xa4\xe3\x81\x8c0.99\xe4\xbb\xa5\xe4\xb8\x8a\xef\xbc\x89\n    _IsNormalMatch = Abs(dotProduct) >= 0.99\nEnd Function\n\n\'// ============================================================\n// \xe8\xa3\x9c\xe8\xb6\xb3\xe8\xaa\xac\xe6\x98\x8e\n\'// ============================================================\n\'// \xe3\x81\x93\xe3\x81\xae\xe3\x83\x9e\xe3\x82\xaf\xe3\x83\xad\xe3\x81\xafCATIA V5\xe3\x81\xaeAPI\xe3\x82\x92\xe4\xbd\xbf\xe7\x94\xa8\xe3\x81\x97\xe3\x81\xa6\xe5\xb9\xb3\x