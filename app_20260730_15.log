rmal_x, normal_y, normal_z,\n                         min_size, tolerance, prefix):\n    """\n    VBA\xe3\x82\xbd\xe3\x83\xbc\xe3\x82\xb9\xe3\x82\xb3\xe3\x83\xbc\xe3\x83\x89\xe3\x82\x92\xe7\x94\x9f\xe6\x88\x90\xe3\x81\x99\xe3\x82\x8b\n    """\n    # \xe6\xb3\x95\xe7\xb7\x9a\xe6\x96\xb9\xe5\x90\x91\xe3\x81\xae\xe6\x8c\x87\xe5\xae\x9a\xe6\x9c\x89\xe7\x84\xa1\xe3\x82\x92\xe3\x83\x81\xe3\x82\xa7\xe3\x83\x83\xe3\x82\xaf\n    has_normal_spec = normal_x is not None or normal_y is not None or normal_z is not None\n    \n    # \xe6\xb3\x95\xe7\xb7\x9a\xe6\x96\xb9\xe5\x90\x91\xe3\x81\xae\xe3\x83\x87\xe3\x83\x95\xe3\x82\xa9\xe3\x83\xab\xe3\x83\x88\xe5\x80\xa4\n    norm_x_val = normal_x if normal_x is not None else 0\n    norm_y_val = normal_y if normal_y is not None else 0\n    norm_z_val = normal_z if normal_z is not None else 0\n    \n    vba_code = f\'\'\'// ============================================================\n// CATIA V5 \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe6\x8a\xbd\xe5\x87\xba\xe3\x83\x9e\xe3\x82\xaf\xe3\x83\xad\n// \xe7\x94\x9f\xe6\x88\x90\xe6\x97\xa5\xe6\x99\x82: {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}\n// \xe5\x85\xa5\xe5\x8a\x9b\xe3\x83\x95\xe3\x82\xa1\xe3\x82\xa4\xe3\x83\xab: {input_path}\n// \xe3\x83\xa2\xe3\x82\xb8\xe3\x83\xa5\xe3\x83\xbc\xe3\x83\xab\xe5\x90\x8d: {module_name}\n// ============================================================\n\nOption Explicit\n\nSub CATMain()\n    \'// \xe5\xa4\x89\xe6\x95\xb0\xe5\xae\xa3\xe8\xa8\x80\n    Dim document1 As Document\n    Dim part1 As Part\n    Dim selection1 As Selection\n    Dim hybridShapeFactory1 As HybridShapeFactory\n    Dim hybridBodies1 As HybridBodies\n    Dim hybridBody1 As HybridBody\n    Dim products1 As Products\n    Dim product1 As Product\n    Dim assemblies1 As assemblies\n    Dim assembly1 As assembly\n    Dim components1 As Variant\n    Dim i As Integer\n    \n    \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe6\xa0\xbc\xe7\xb4\x8d\xe7\x94\xa8\xe3\x82\xb3\xe3\x83\xac\xe3\x82\xaf\xe3\x82\xb7\xe3\x83\xa7\xe3\x83\xb3\n    Dim planeSurfaces As Collection\n    Set planeSurfaces = New Collection\n    \n    \'// \xe5\x85\xa5\xe5\x8a\x9b\xe3\x83\x95\xe3\x82\xa1\xe3\x82\xa4\xe3\x83\xab\xe3\x83\x91\xe3\x82\xb9\n    Dim inputFilePath As String\n    inputFilePath = "{input_path}"\n    \n    \'// \xe6\x9c\x80\xe5\xb0\x8f\xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x82\xa4\xe3\x82\xba\xef\xbc\x88mm\xef\xbc\x89\n    Dim minSize As Double\n    minSize = {min_size}\n    \n    \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe5\x88\xa4\xe5\xae\x9a\xe8\xa8\xb1\xe5\xae\xb9\xe8\xaa\xa4\xe5\xb7\xae\xef\xbc\x88mm\xef\xbc\x89\n    Dim tolerance As Double\n    tolerance = {tolerance}\n    \n    \'// \xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe5\x90\x8d\xe3\x83\x97\xe3\x83\xac\xe3\x83\x95\xe3\x82\xa3\xe3\x83\x83\xe3\x82\xaf\xe3\x82\xb9\n    Dim surfacePrefix As String\n    surfacePrefix = "{prefix}"\n    \n    Try\n        \'// \xe5\x85\xa5\xe5\x8a\x9b\xe3\x83\x95\xe3\x82\xa1\xe3\x82\xa4\xe3\x83\xab\xe3\x82\x92\xe9\x96\x8b\xe3\x81\x8f\n        Set document1 = CATIA.Documents.Open(inputFilePath)\n        \n        \'// Part\xe3\x82\xaa\xe3\x83\x96\xe3\x82\xb8\xe3\x82\xa7\xe3\x82\xaf\xe3\x83\x88\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n        Set part1 = document1.Part\n        \n        \'// \xe3\x83\x8f\xe3\x82\xa4\xe3\x83\x96\xe3\x83\xaa\xe3\x83\x83\xe3\x83\x89\xe3\x82\xb8\xe3\x82\xaa\xe3\x83\xa1\xe3\x83\x88\xe3\x83\xaa\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n        Dim hybridBodyDesign As HybridBody\n        Set hybridBodyDesign = part1.MainItem.FindObjectByName("Geometric Set")\n        If hybridBodyDesign Is Nothing Then\n            \'// Geometric Set\xe3\x81\x8c\xe5\xad\x98\xe5\x9c\xa8\xe3\x81\x97\xe3\x81\xaa\xe3\x81\x84\xe5\xa0\xb4\xe5\x90\x88\xe3\x81\xaf\xe6\x96\xb0\xe8\xa6\x8f\xe4\xbd\x9c\xe6\x88\x90\n            Set hybridBodyDesign = part1.HybridBodies.Add()\n            hybridBodyDesign.Name = "Geometric Set"\n        End If\n        \n        \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe7\x94\xa8\xe3\x81\xaeGeometric Set\xe3\x82\x92\xe4\xbd\x9c\xe6\x88\x90\n        Dim planeGeoSet As HybridBody\n        Set planeGeoSet = part1.HybridBodies.Add()\n        planeGeoSet.Name = "Plane_Surfaces"\n        \n        \'// \xe3\x83\x8f\xe3\x82\xa4\xe3\x83\x96\xe3\x83\xaa\xe3\x83\x83\xe3\x83\x89\xe5\xbd\xa2\xe7\x8a\xb6\xe3\x83\x95\xe3\x82\xa1\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xaa\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n        Set hybridShapeFactory1 = part1.HybridShapeFactory\n        \n        \'// \xe9\x81\xb8\xe6\x8a\x9e\xe3\x82\xbb\xe3\x83\x83\xe3\x83\x88\xe3\x82\x92\xe4\xbd\x9c\xe6\x88\x90\xef\xbc\x88\xe5\xb9\xb3\xe9\x9d\xa2\xe6\xa4\x9c\xe5\x87\xba\xe7\x94\xa8\xef\xbc\x89\n        Set selection1 = document1.Selection\n        selection1.Clear\n        \n        \'// \xe5\x85\xa8\xe3\x81\xa6\xe3\x81\xae\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x82\x92\xe6\xa4\x9c\xe5\x87\xba\n        Call selection1.Search("Topology.Face,all")\n        \n        Dim faceCount As Integer\n        faceCount = selection1.Count2\n        \n        If faceCount = 0 Then\n            MsgBox "\xe5\xb9\xb3\xe9\x9d\xa2\xe3\x81\x8c\xe6\xa4\x9c\xe5\x87\xba\xe3\x81\x95\xe3\x82\x8c\xe3\x81\xbe\xe3\x81\x9b\xe3\x82\x93\xe3\x81\xa7\xe3\x81\x97\xe3\x81\x9f\xe3\x80\x82", vbInformation, "\xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe6\x8a\xbd\xe5\x87\xba"\n            Exit Sub\n        End If\n        \n        \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\x92\xe3\x83\x95\xe3\x82\xa3\xe3\x83\xab\xe3\x82\xbf\xe3\x83\xaa\xe3\x83\xb3\xe3\x82\xb0\xe3\x81\x97\xe3\x81\xa6\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe4\xbd\x9c\xe6\x88\x90\n        Dim processedCount As Integer\n        processedCount = 0\n        \n        For i = 1 To faceCount\n            Dim face1 As HybridShapeSurfaceExplicit\n            Set face1 = selection1.Item2(i).Value\n            \n            \'// \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe5\xbd\xa2\xe7\x8a\xb6\xe3\x82\xbf\xe3\x82\xa4\xe3\x83\x97\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n            Dim shapeType As String\n            shapeType = face1.Type\n            \n            \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x81\x8b\xe3\x83\x81\xe3\x82\xa7\xe3\x83\x83\xe3\x82\xaf\n            If shapeType = "Plane" Then\n                \'// \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe3\x82\xb5\xe3\x82\xa4\xe3\x82\xba\xe3\x82\x92\xe3\x83\x81\xe3\x82\xa7\xe3\x83\x83\xe3\x82\xaf\n                Dim faceArea As Double\n                faceArea = _GetFaceArea(face1)\n                \n                If faceArea >= minSize Then\n                    \'// \xe6\xb3\x95\xe7\xb7\x9a\xe6\x96\xb9\xe5\x90\x91\xe3\x81\xae\xe3\x83\x95\xe3\x82\xa3\xe3\x83\xab\xe3\x82\xbf\xe3\x83\xaa\xe3\x83\xb3\xe3\x82\xb0\xef\xbc\x88\xe6\x8c\x87\xe5\xae\x9a\xe3\x81\x8c\xe3\x81\x82\xe3\x82\x8b\xe5\xa0\xb4\xe5\x90\x88\xef\xbc\x89\n                    If {str(has_normal_spec).lower()} Then\n                        Dim normalX As Double, normalY As Double, normalZ As Double\n                        Call _GetFaceNormal(face1, normalX, normalY, normalZ)\n                        \n                        If Not _IsNormalMatch(normalX, normalY, normalZ, {norm_x_val},\n                                            {norm_y_val},\n                                            {norm_z_val}) Then\n                            Continue\n                        End If\n                    End If\n                    \n                    \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x82\x92\xe4\xbd\x9c\xe6\x88\x90\n                    Dim planeName As String\n                    planeName = surfacePrefix & "_" & CStr(processedCount + 1)\n                    \n                    Dim newPlane As HybridShapePlanePointNormal\n                    Set newPlane = hybridShapeFactory1.AddNewPlanePointNormal()\n                    \n                    \'// \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\x8b\xe3\x82\x89\xe6\x83\x85\xe5\xa0\xb1\xe5\x8f\x96\xe5\xbe\x97\n                    Dim normalX As Double, normalY As Double, normalZ As Double\n                    Dim pointX As Double, pointY As Double, pointZ As Double\n                    Call _GetFaceNormal(face1, normalX, normalY, normalZ)\n                    Call _GetFaceCenter(face1, pointX, pointY, pointZ)\n                    \n                    \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe3\x83\x91\xe3\x83\xa9\xe3\x83\xa1\xe3\x83\xbc\xe3\x82\xbf\xe8\xa8\xad\xe5\xae\x9a\n                    newPlane.NormalX = normalX\n                    newPlane.NormalY = normalY\n                    newPlane.NormalZ = normalZ\n                    newPlane.PointX = pointX\n                    newPlane.PointY = pointY\n                    newPlane.PointZ = pointZ\n                    \n                    \'// \xe3\x83\x8f\xe3\x82\xa4\xe3\x83\x96\xe3\x83\xaa\xe3\x83\x83\xe3\x83\x89\xe3\x82\xb8\xe3\x82\xaa\xe3\x83\xa1\xe3\x83\x88\xe3\x83\xaa\xe3\x81\xab\xe8\xbf\xbd\xe5\x8a\xa0\n                    newPlane.Name = planeName\n                    Call hybridBodyDesign.AppendHybridShape(newPlane)\n                    \n                    \'// \xe6\x9b\xb4\xe6\x96\xb0\n                    part1.UpdateObject newPlane\n                    \n                    \'// \xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x82\xb3\xe3\x83\xac\xe3\x82\xaf\xe3\x82\xb7\xe3\x83\xa7\xe3\x83\xb3\xe3\x81\xab\xe8\xbf\xbd\xe5\x8a\xa0\n                    planeSurfaces.Add newPlane\n                    \n                    processedCount = processedCount + 1\n                End If\n            End If\n        Next i\n        \n        \'// \xe9\x81\xb8\xe6\x8a\x9e\xe3\x82\x92\xe3\x82\xaf\xe3\x83\xaa\xe3\x82\xa2\n        selection1.Clear\n        \n        MsgBox "\xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x82\x92 " & processedCount & " \xe4\xbb\xb6\xe4\xbd\x9c\xe6\x88\x90\xe3\x81\x97\xe3\x81\xbe\xe3\x81\x97\xe3\x81\x9f\xe3\x80\x82", vbInformation, "\xe5\xb9\xb3\xe9\x9d\xa2\xe3\x82\xb5\xe3\x83\xbc\xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe6\x8a\xbd\xe5\x87\xba"\n        \n    Catch ex As Exception\n        MsgBox "\xe3\x82\xa8\xe3\x83\xa9\xe3\x83\xbc\xe3\x81\x8c\xe7\x99\xba\xe7\x94\x9f\xe3\x81\x97\xe3\x81\xbe\xe3\x81\x97\xe3\x81\x9f: " & ex.Description, vbCritical, "\xe3\x82\xa8\xe3\x83\xa9\xe3\x83\xbc"\n    End Try\nEnd Sub\n\n\'// ============================================================\n// \xe3\x82\xb5\xe3\x83\x96\xe3\x83\x97\xe3\x83\xad\xe3\x82\xb7\xe3\x83\xbc\xe3\x82\xb8\xe3\x83\xa3: \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe9\x9d\xa2\xe7\xa9\x8d\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n\'// ============================================================\nFunction _GetFaceArea(face As Object) As Double\n    Dim bounds(1) As Double\n    Dim area As Double\n    \n    Try\n        \'// \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe5\xa2\x83\xe7\x95\x8c\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n        Call face.GetBounds(bounds(0), bounds(1))\n        \n        \'// \xe7\xb0\xa1\xe6\x98\x93\xe9\x9d\xa2\xe7\xa9\x8d\xe8\xa8\x88\xe7\xae\x97\xef\xbc\x88\xe5\xae\x9f\xe9\x9a\x9b\xe3\x81\xaeCATIA API\xe3\x81\xa7\xe3\x81\xaf\xe3\x82\x88\xe3\x82\x8a\xe6\xad\xa3\xe7\xa2\xba\xe3\x81\xaa\xe6\x96\xb9\xe6\xb3\x95\xe3\x81\x8c\xe5\xbf\x85\xe8\xa6\x81\xef\xbc\x89\n        Dim width As Double, height As Double\n        width = Abs(bounds(1)(0) - bounds(0)(0))\n        height = Abs(bounds(1)(1) - bounds(0)(1))\n        \n        area = width * height\n    Catch ex As Exception\n        area = 0\n    End Try\n    \n    _GetFaceArea = area\nEnd Function\n\n\'// ============================================================\n// \xe3\x82\xb5\xe3\x83\x96\xe3\x83\x97\xe3\x83\xad\xe3\x82\xb7\xe3\x83\xbc\xe3\x82\xb8\xe3\x83\xa3: \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe6\xb3\x95\xe7\xb7\x9a\xe3\x83\x99\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xab\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n\'// ============================================================\nSub _GetFaceNormal(face As Object, ByRef normalX As Double, ByRef normalY As Double, ByRef normalZ As Double)\n    Try\n        \'// \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe6\xb3\x95\xe7\xb7\x9a\xe3\x83\x99\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xab\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\xef\xbc\x88CATIA API\xe3\x82\x92\xe4\xbd\xbf\xe7\x94\xa8\xef\xbc\x89\n        \'// \xe5\xae\x9f\xe9\x9a\x9b\xe3\x81\xaeCATIA VBA\xe3\x81\xa7\xe3\x81\xafGeometry\xe3\x82\xaa\xe3\x83\x96\xe3\x82\xb8\xe3\x82\xa7\xe3\x82\xaf\xe3\x83\x88\xe3\x81\xaeNormal\xe3\x83\x97\xe3\x83\xad\xe3\x83\x91\xe3\x83\x86\xe3\x82\xa3\xe3\x82\x92\xe4\xbd\xbf\xe7\x94\xa8\n        normalX = 0\n        normalY = 0\n        normalZ = 1  \'// \xe3\x83\x87\xe3\x83\x95\xe3\x82\xa9\xe3\x83\xab\xe3\x83\x88\xe5\x80\xa4\xef\xbc\x88\xe4\xb8\x8a\xe6\x96\xb9\xe5\x90\x91\xef\xbc\x89\n    Catch ex As Exception\n        normalX = 0\n        normalY = 0\n        normalZ = 1\n    End Try\nEnd Sub\n\n\'// ============================================================\n// \xe3\x82\xb5\xe3\x83\x96\xe3\x83\x97\xe3\x83\xad\xe3\x82\xb7\xe3\x83\xbc\xe3\x82\xb8\xe3\x83\xa3: \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe4\xb8\xad\xe5\xbf\x83\xe7\x82\xb9\xe3\x82\x92\xe5\x8f\x96\xe5\xbe\x97\n\'// ============================================================\nSub _GetFaceCenter(face As Object, ByRef centerX As Double, ByRef centerY As Double, ByRef centerZ As Double)\n    Try\n        \'// \xe3\x83\x95\xe3\x82\xa7\xe3\x83\xbc\xe3\x82\xb9\xe3\x81\xae\xe4\xb8\xad\xe5\xbf\x83\xe7\x82\xb9\xe3\x82\x92\xe8\xa8\x88\xe7\xae\x97\n        Dim bounds(1) As Double\n        Call face.GetBounds(bounds(0), bounds(1))\n        \n        centerX = (bounds(0)(0) + bounds(1)(0)) / 2\n        centerY = (bounds(0)(1) + bounds(1)(1)) / 2\n        centerZ = (bounds(0)(2) + bounds(1)(2)) / 2\n    Catch ex As Exception\n        centerX = 0\n        centerY = 0\n        centerZ = 0\n    End Try\nEnd Sub\n\n\'// ============================================================\n// \xe3\x82\xb5\xe3\x83\x96\xe3\x83\x97\xe3\x83\xad\xe3\x82\xb7\xe3\x83\xbc\xe3\x82\xb8\xe3\x83\xa3: \xe6\xb3\x95\xe7\xb7\x9a\xe3\x83\x99\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xab\xe3\x81\xae\xe4\xb8\x80\xe8\x87\xb4\xe3\x83\x81\xe3\x82\xa7\xe3\x83\x83\xe3\x82\xaf\n\'// ============================================================\nFunction _IsNormalMatch(nx As Double, ny As Double, nz As Double,\n                       targetX As Double, targetY As Double, targetZ As Double) As Boolean\n    Dim dotProduct As Double\n    Dim magnitude1 As Double, magnitude2 As Double\n    \n    \'// \xe5\x86\x85\xe7\xa9\x8d\xe3\x82\x92\xe8\xa8\x88\xe7\xae\x97\n    dotProduct = nx * targetX + ny * targetY + nz * targetZ\n    \n    \'// \xe5\x90\x84\xe3\x83\x99\xe3\x82\xaf\xe3\x83\x88\xe3\x83\xab\xe3\x81\xae\xe5\xa4\xa7\xe3\x81\x8d\xe3\x81\x95\xe3\x82\x92\xe8\xa8\x88\xe7\xae\x97\n    magnitude1 = Sqr(nx * nx + ny * ny + nz * nz)\n    magnitude2 = Sqr(targetX * targetX + targetY * targetY + targetZ * targetZ)\n    \n    \'// \xe6\xad\xa3\xe8\xa6\x8f\xe5\x8c\x96\n    If magnitude1 > 0 And magnitude2 > 0 Then\n        dotProduct = dotProduct / (magnitude1 * magnitude2)\n    End If\n    \n    \'// \xe4\xb8\x80\xe8\x87\xb4\xe5\x88\xa4\xe5\xae\x9a\xef\xbc\x88cos\xe5\x80\xa4\xe3\x81\x8c0.99\xe4\xbb\xa5\xe4\xb8\x8a\xef\xbc\x89\n    _IsNormalMatch = Abs(dotProduct) >= 0.99\nEnd Function\n\n\'// ===================================